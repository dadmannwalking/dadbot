<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dadmannwalking.dadbot</string>
  <key>ProgramArguments</key>
  <array><string>__PROJECT_PATH__/scripts/run.sh</string></array>
  <key>WorkingDirectory</key><string>__PROJECT_PATH__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__PROJECT_PATH__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_PATH__/logs/launchd.err.log</string>
</dict>
</plist>
