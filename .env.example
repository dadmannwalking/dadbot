# Required: token from Discord Developer Portal > Applications > Bot.
DISCORD_BOT_TOKEN=

# Required: numeric ID of the Discord server used for development/testing.
DISCORD_TEST_GUILD_ID=

# Required only when DISCORD_SEND_TEST_MESSAGE=true: numeric text-channel ID.
DISCORD_TEST_CHANNEL_ID=

# Optional: set to true to send and then immediately delete a test message.
DISCORD_SEND_TEST_MESSAGE=false

# Optional: content of the temporary test message.
DISCORD_TEST_MESSAGE=Dadbot bootstrap connection test.

# Optional: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Production aliases. Existing DISCORD_TEST_* values remain supported as fallbacks.
DISCORD_GUILD_ID=
DISCORD_DEFAULT_CHANNEL_ID=
# Optional per-feature destinations; each falls back to the default channel.
DISCORD_YOUTUBE_UPLOAD_CHANNEL_ID=
DISCORD_LIVE_NOTIFICATION_CHANNEL_ID=
DISCORD_SUGGESTION_CHANNEL_ID=
DISCORD_HIGHLIGHT_CHANNEL_ID=

# Comma-separated Discord user IDs allowed to use developer commands.
DISCORD_OWNER_IDS=
DEVELOPMENT_MODE=true
DISCORD_SYNC_COMMANDS=true

# IANA timezone and local storage paths.
BOT_TIMEZONE=America/Indiana/Indianapolis
DATABASE_PATH=data/dadbot.sqlite3
CONTENT_PATH=content
LOG_PATH=logs/dadbot.log
BACKUP_RETENTION=14

# YouTube uploads use Atom and need only the channel ID. Livestream status also
# requires a YouTube Data API key; leave both blank to disable the monitors.
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
YOUTUBE_POLL_MINUTES=15
LIVESTREAM_POLL_MINUTES=5

# Twitch livestream checks use an application registered in the Twitch developer console.
# Leave any value blank to disable the Twitch monitor.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_LOGIN=
TWITCH_POLL_MINUTES=2

# Engagement timing. Weekdays use Monday=0 through Sunday=6.
DAD_JOKE_MIN_DAYS=2
DAD_JOKE_MAX_DAYS=4
SHOWCASE_MIN_DAYS=7
SHOWCASE_MAX_DAYS=12
QUESTION_WEEKDAY=1
POLL_WEEKDAY=4
SCHEDULE_HOUR_START=10
SCHEDULE_HOUR_END=20
